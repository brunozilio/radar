{
  "name": "monitoramento-rio-taquari",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:next": "next dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "start:next": "next start",
    "worker": "node --experimental-strip-types scripts/worker.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern .next",
    "cloudflare:dry-run": "wrangler deploy --config ./wrangler.jsonc --dry-run --strict --keep-vars",
    "cloudflare:deploy": "wrangler deploy --config ./wrangler.jsonc --strict --keep-vars --containers-rollout=immediate --message \"Corrige radar de Concórdia\""
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "$sharp"
  },
  "type": "module"
}
